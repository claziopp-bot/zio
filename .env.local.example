# Supabase (Supabase 프로젝트 Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 네이버 지도 (NCP 콘솔 > Application Services > Maps 에서 발급)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 네이버 검색 오픈API - 지역 검색용 (developers.naver.com 에서 발급)
# 서버(API route)에서만 사용하므로 NEXT_PUBLIC_ 접두사 없음
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
